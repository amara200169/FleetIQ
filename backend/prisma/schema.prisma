generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password      String
  role          String    @default("DRIVER")
  isActive      Boolean   @default(true)
  firstName     String?
  lastName      String?
  phone         String?
  avatar        String?
  licenseNumber String?
  licenseExpiry DateTime?
  address       String?
  latitude      Float?
  longitude     Float?
  lastSeen      DateTime?
  emailVerified          Boolean   @default(false)
  emailVerificationCode  String?
  emailVerificationExpiry DateTime?
  stripeCustomerId   String?
  subscriptionStatus String    @default("trialing")
  subscriptionId     String?
  trialEndsAt        DateTime?
  createdById        Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  ownedVehicles    Vehicle[]       @relation("VehicleOwner")
  assignedVehicles Vehicle[]       @relation("VehicleDriver")
  deliveries       Delivery[]      @relation("DeliveryDriver")
  sentMessages     Message[]       @relation("MessageSender")
  receivedMessages Message[]       @relation("MessageReceiver")
  notifications    Notification[]
  fuelLogs         FuelLog[]
  maintenanceLogs  MaintenanceLog[]
  locationHistory     LocationHistory[]
  passwordResetTokens PasswordResetToken[]
}

model Vehicle {
  id                 Int       @id @default(autoincrement())
  ownerId            Int
  driverId           Int?
  licensePlate       String    @unique
  make               String?
  model              String
  year               Int?
  color              String?
  capacity           Int
  status             String    @default("ACTIVE")
  active             Boolean   @default(true)
  currentMileage     Int       @default(0)
  insuranceExpiry    DateTime?
  registrationExpiry DateTime?
  lastServiceDate    DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  owner           User             @relation("VehicleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  driver          User?            @relation("VehicleDriver", fields: [driverId], references: [id], onDelete: SetNull)
  deliveries      Delivery[]
  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]
}

model Delivery {
  id            Int       @id @default(autoincrement())
  description   String
  customerName  String?
  customerPhone String?
  customerEmail String?
  pickupAddress String?
  destination   String
  latitude      Float?
  longitude     Float?
  scheduledAt   DateTime?
  priority      String    @default("NORMAL")
  status        String    @default("PENDING")
  deliveredAt   DateTime?
  proofImage    String?
  deliveryNote  String?
  deliveryCost  Float?
  vehicleId     Int
  driverId      Int?
  trackingSlug  String?   @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver         User?           @relation("DeliveryDriver", fields: [driverId], references: [id], onDelete: SetNull)
  trackingEvents TrackingEvent[]
}

model FuelLog {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  driverId    Int
  fuelAmount  Float
  fuelCost    Float
  odometer    Int
  fuelStation String?
  notes       String?
  createdAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  User    @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model MaintenanceLog {
  id             Int       @id @default(autoincrement())
  vehicleId      Int
  performedById  Int
  type           String
  description    String
  cost           Float?
  odometer       Int?
  nextDueDate    DateTime?
  nextDueMileage Int?
  notes          String?
  createdAt      DateTime  @default(now())

  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  performedBy User    @relation(fields: [performedById], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
}

model LocationHistory {
  id        Int      @id @default(autoincrement())
  driverId  Int
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  driver User @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrackingEvent {
  id         Int      @id @default(autoincrement())
  deliveryId Int
  actorId    Int?
  event      String
  notes      String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}
